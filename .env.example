# ReleaseShield environment configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Demo repository path (defaults to ./demo-repo relative to this file)
DEMO_REPO_PATH=./demo-repo

# IBM Bob executable name on PATH
BOB_EXECUTABLE=bob

# Bob custom mode to use
BOB_MODE=release-shield

# Bob timeout in seconds
BOB_TIMEOUT=120

# Whether to use real Bob (true) or simulation mode (false)
USE_REAL_BOB=true

# Python/pytest executables
PYTHON_EXECUTABLE=python
PYTEST_EXECUTABLE=pytest

# Max self-healing repair attempts before giving up
MAX_REPAIR_ATTEMPTS=2

# CORS origins for frontend
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Artifacts output directory
ARTIFACTS_DIR=./artifacts

# Frontend API URL (set in frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
